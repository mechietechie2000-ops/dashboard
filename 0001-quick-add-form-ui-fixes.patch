diff --git a/frontend/src/index.css b/frontend/src/index.css
index d3e0bab..428d107 100755
--- a/frontend/src/index.css
+++ b/frontend/src/index.css
@@ -1,7 +1,13 @@
 /* Force flex layout for root app */
 .app {
   display: flex !important;
-  width: 100vw;
+  /* 100% instead of 100vw: 100vw includes the scrollbar's own width on
+     desktop browsers, which is wider than the visible page whenever a
+     scrollbar is present. Opening a Modal (e.g. the "+" add form) removes
+     the page scrollbar, so 100vw suddenly grows by the scrollbar's width
+     and the whole app shifts/overflows — forcing the user to zoom out to
+     see it centered again. 100% avoids that mismatch entirely. */
+  width: 100%;
   height: 100vh;
   overflow: hidden;
 }
