{
  "name": "dashboard",
  "version": "1.0.0",
  "scripts": {
    "server": "npm run dev --prefix backend",
    "client": "npm start --prefix frontend",
    "dev": "concurrently -k -p \"[{name}]\" -n \"backend,frontend\" -c \"yellow,cyan\" \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "http-proxy-middleware": "^3.0.7",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^3.0.1",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
