+    const next = { ...row };
+    for (const col of cfg.jsonColumns) {
+      if (typeof next[col] === "string" && next[col]) {
+        try {
+          next[col] = JSON.parse(next[col]);
+        } catch {
+          // leave as-is if it's not valid JSON (e.g. legacy/blank data)
+        }
+      }
+    }
+    return next;
+  });
