    db.all('SELECT * FROM event', (err, rows) => {
    //db.all('PRAGMA database_list;', (err, rows) => { //useful in debugging
      if (err) {
        res.status(500).json({ error: err.message });
        return;
      }
      res.json(rows);
    });
  });

app.get('/getKidsMenu', async (req, res) => {
    db.all('SELECT MEAL_TIME, MEAL_TYPE, MEAL_NAME,DAY_OF_WEEK  FROM meal order by MEAL_TIME DESC', (err, rows) => {
    //db.all('PRAGMA database_list;', (err, rows) => { //useful in debugging
      if (err) {
        res.status(500).json({ error: err.message });
        return;
      }
      res.json(rows);
    });
  });

app.post('/addNewEvent', (req, res) => {
//  const data = req.body
//    console.log(data)
    const field1 = req.body.EventFor
    const field2 = req.body.EventName
    const field3 = req.body.EventTime

    //const { field1, field2, field3 } = data; // Assuming you're receiving specific fields from the frontend
    //Perform database insertion using the received data
    
    //console.log(field1, field2, field3)
    db.run('INSERT INTO event (PERSON_NAME, EVENT_NAME, EVENT_TIME) VALUES (?, ?, ?)', [field1, field2, field3], (err) => {
      if (err) {
        res.status(500).json({ error: err.message });
        return;
      }
      res.json({ message: 'Data inserted successfully' });
    });
  });

app.post('/deleteEvent', (req, res) => {
  const field1 = req.body.EventFor
  const field2 = req.body.EventName
  const field3 = req.body.EventTime
  
  //console.log(field1, field2, field3)
  db.run('delete from event where (PERSON_NAME, EVENT_NAME, EVENT_TIME) VALUES (?, ?, ?)', [field1, field2, field3], (err) => {
    if (err) {
      res.status(500).json({ error: err.message });
      return;
    }
    res.json({ message: 'Data inserted successfully' });
  });
});  

app.post('/updateEvent', (req, res) => {
  const field1 = req.body.EventFor
  const field2 = req.body.EventName
  const field3 = req.body.EventTime
  
  //console.log(field1, field2, field3)
  db.run('update event (PERSON_NAME, EVENT_NAME, EVENT_TIME) VALUES (?, ?, ?)', [field1, field2, field3], (err) => {
    if (err) {
      res.status(500).json({ error: err.message });
      return;
    }
    res.json({ message: 'Data inserted successfully' });
  });
});  

